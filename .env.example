# The official Comfy SDK talks to this open-source v2 proxy.
COMFY_BASE_URL=http://127.0.0.1:8189
COMFY_UI_URL=http://127.0.0.1:8188
# Leave unset for local ComfyUI. Never place keys in frontend code.
# COMFY_API_KEY=
# Optional: a paid Comfy Cloud plan's key connects Comfy Cloud at startup. Studios
# still render on your GPU unless you chose Comfy Cloud for them in Render setup.
# You can also enter the key there, which keeps it in memory only.
# COMFY_CLOUD_API_KEY=
PORT=4310
AFTERTAKE_DATA_DIR=.data
# Optional narration uses its own CPU environment. Install with scripts/setup-narration.py.
# AFTERTAKE_NARRATION_PYTHON=/absolute/path/to/voice-venv/bin/python
# AFTERTAKE_NARRATION_MODELS=/absolute/path/to/narration-models
