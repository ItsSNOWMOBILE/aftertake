{
  "name": "aftertake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Direct where and when a video transformation happens, with open-weight ComfyUI workflows.",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "demo": "node scripts/run-demo.mjs",
    "build": "tsc --noEmit && vite build",
    "build:browser-demo": "tsx scripts/build-browser-demo.mts",
    "start": "tsx server/index.ts --production",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@comfyorg/sdk": "^0.5.0",
    "express": "^5.3.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
