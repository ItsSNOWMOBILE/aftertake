      "position": "bottom",
      "animation": "fade",
      "color": "#ffffff"
    },
    {
      "id": "ba5bc3c4-274f-5831-934a-048b13075865",
      "text": "Choose what changes.",
      "start": 19.32833333333333,
      "end": 21.12833333333333,
      "style": "caption",
      "position": "bottom",
      "animation": "fade",
      "color": "#ffffff"
    },
    {
      "id": "a49c1fdf-1797-5b38-b4c1-421ebe5d66f0",
      "text": "Change reality.",
      "start": 21.16166666666666,
      "end": 23.711666666666662,
      "style": "headline",
      "position": "bottom",
      "animation": "fade",
      "color": "#ffffff"
    },
    {
      "id": "bf7f2fb8-0d43-5a4b-8c44-1e9cc09c7186",
      "text": "Cast your own character.",
