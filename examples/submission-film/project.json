      "position": "bottom",
      "animation": "fade",
      "color": "#ffffff"
    },
    {
      "id": "6a0dfcd4-beab-5d9d-9c7d-b25427aa3e60",
      "text": "Change the words, voice and timing.",
      "start": 12.786666666666665,
      "end": 15.128333333333332,
