  "titles": [
    {
      "id": "69d4c3d3-243b-4e79-b8fb-d22c718ad14d",
      "text": "Paint where and when the scene changes.",
      "start": 3.625,
      "end": 6.0056666666666665,
      "style": "caption",
      "position": "bottom",
      "animation": "fade",
      "fontSize": 34,
      "color": "#ffffff"
    },
    {
      "id": "3c7f326b-4119-41c8-a896-856525d8ae51",
      "text": "Qwen prepares your reference.",
      "start": 7.125,
      "end": 9.056333333333333,
      "style": "caption",
      "position": "bottom",
      "animation": "fade",
      "fontSize": 34,
      "color": "#ffffff"
    },
    {
      "id": "f05b48d4-01c4-4a86-a287-5febff320345",
      "text": "The same cue guides generation and the blend.",
      "start": 10.125,
      "end": 13.059000000000001,
      "style": "caption",
      "position": "bottom",
      "animation": "fade",
      "fontSize": 34,
      "color": "#ffffff"
    },
    {
      "id": "1ed8604a-d9b6-48d5-ac5d-fd2ec6c7ee7e",
      "text": "Cast your own character.",
      "start": 13.625,
      "end": 15.238958333333333,
      "style": "caption",
      "position": "bottom",
      "animation": "fade",
      "fontSize": 34,
      "color": "#ffffff"
    },
    {
      "id": "27ce8579-2512-4048-9ff1-afd547034f84",
      "text": "Replace a tracked character with H3.",
      "start": 16.125,
      "end": 18.601,
      "style": "caption",
      "position": "bottom",
      "animation": "fade",
      "fontSize": 34,
      "color": "#ffffff"
    },
    {
      "id": "6fe14d28-5428-4ec7-9cfc-f9a616c74d75",
      "text": "Create video with LTX.",
      "start": 19.166666666666668,
      "end": 21.268666666666668,
      "style": "caption",
      "position": "bottom",
      "animation": "fade",
      "fontSize": 34,
      "color": "#ffffff"
    },
    {
      "id": "0e885deb-eee8-464d-ba33-9e0e1aba398d",
      "text": "Write a line for each picture. Kokoro voices it locally.",
      "start": 26.166666666666668,
      "end": 29.858666666666668,
      "style": "caption",
      "position": "bottom",
      "animation": "fade",
      "fontSize": 34,
      "color": "#ffffff"
    },
    {
      "id": "7aea947c-394f-4a7d-ad06-a71baa2132b4",
      "text": "Change the hook. Keep the edit.",
      "start": 30.666666666666668,
      "end": 32.85466666666667,
      "style": "caption",
      "position": "bottom",
      "animation": "fade",
      "fontSize": 34,
      "color": "#ffffff"
    },
    {
      "id": "5c55a6ae-157c-4044-98c7-14c5f1b49a3d",
      "text": "Agents inspect footage, edit, export, and reopen this project.",
      "start": 33.666666666666664,
      "end": 38.139958333333325,
      "style": "caption",
      "position": "bottom",
      "animation": "fade",
      "fontSize": 34,
      "color": "#ffffff"
    },
    {
      "id": "c0ee9638-5ea5-4c37-9070-28ffe4fc0212",
      "text": "Comfy SDK connects local, open-weight workflows.",
      "start": 39.666666666666664,
      "end": 43.45133333333333,
      "style": "caption",
      "position": "bottom",
      "animation": "fade",
      "fontSize": 34,
      "color": "#ffffff"
    },
    {
      "id": "96bfeda0-8b3d-461e-af51-06f66e8426c8",
      "text": "Even this demo was made in Aftertake.",
      "start": 43.666666666666664,
      "end": 46.185333333333325,
      "style": "caption",
      "position": "bottom",
      "animation": "fade",
      "fontSize": 34,
      "color": "#ffffff"
    },
    {
      "id": "26b578f1-a36f-411f-8b65-000000000001",
      "text": "AFTERTAKE",
      "start": 0.125,
      "end": 3.375,
      "style": "headline",
      "position": "top",
      "fontSize": 64,
      "animation": "wipe",
      "color": "#17210f",
      "motionDuration": 0.4
    },
    {
      "id": "26b578f1-a36f-411f-8b65-000000000002",
      "text": "CHANGE THE SCENE.\nKEEP THE SHOT.",
      "start": 1.6666666667,
      "end": 3.375,
      "style": "headline",
      "position": "bottom",
      "fontSize": 40,
      "animation": "fade",
      "color": "#ffffff"
    },
    {
      "id": "26b578f1-a36f-411f-8b65-000000000003",
      "text": "ONE CUE · GENERATION + COMPOSITE",
      "start": 10.125,
      "end": 13.3333333333,
      "style": "caption",
      "position": "top",
      "fontSize": 25,
      "animation": "fade",
      "color": "#c9ec89"
    },
    {
      "id": "26b578f1-a36f-411f-8b65-000000000004",
      "text": "SOURCE",
      "start": 16.125,
      "end": 17.25,
      "style": "caption",
      "position": "top",
      "fontSize": 25,
      "animation": "none",
      "color": "#c9ec89"
    },
    {
      "id": "26b578f1-a36f-411f-8b65-000000000005",
      "text": "H3 · TRACKED CHARACTER REPLACEMENT",
      "start": 17.25,
      "end": 18.9166666667,
      "style": "caption",
      "position": "top",
      "fontSize": 25,
      "animation": "none",
      "color": "#c9ec89"
    },
    {
      "id": "26b578f1-a36f-411f-8b65-000000000006",
      "text": "LTX · FROM TEXT TO VIDEO",
      "start": 21.625,
      "end": 24.4166666667,
      "style": "caption",
      "position": "top",
      "fontSize": 25,
      "animation": "fade",
      "color": "#c9ec89"
    },
    {
      "id": "26b578f1-a36f-411f-8b65-000000000007",
      "text": "LOCAL OPEN-WEIGHT WORKFLOWS",
      "start": 39.6666666667,
      "end": 43.375,
      "style": "kicker",
      "position": "top",
      "fontSize": 25,
      "animation": "fade",
      "color": "#c9ec89"
    },
    {
      "id": "26b578f1-a36f-411f-8b65-000000000008",
      "text": "LOCAL COMFYUI\nCONNECTED WITH COMFY SDK",
      "start": 39.6666666667,
      "end": 43.375,
      "style": "headline",
      "position": "center",
      "fontSize": 53,
      "animation": "wipe",
      "color": "#ffffff",
      "motionDuration": 0.45
    },
    {
      "id": "26b578f1-a36f-411f-8b65-000000000009",
      "text": "CUT · TITLED · VOICED · EXPORTED HERE",
      "start": 43.6666666667,
      "end": 47.375,
      "style": "kicker",
      "position": "top",
      "fontSize": 25,
      "animation": "fade",
      "color": "#c9ec89"
    },
    {
      "id": "26b578f1-a36f-411f-8b65-000000000010",
      "text": "Make the next take yours.",
      "start": 47.6666666667,
      "end": 50.0416666667,
